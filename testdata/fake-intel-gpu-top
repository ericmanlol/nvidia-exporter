#!/bin/bash
# Test stand-in for intel_gpu_top -J: prints the fixture's JSON array one
# sample at a time, then stays alive like the real tool does.
if [ "$FAKE_INTEL_FAIL" = "1" ]; then
  echo "Failed to initialize PMU! (Permission denied)" >&2
  exit 1
fi
echo "$@" > "${FAKE_INTEL_ARGS_FILE:-/dev/null}"
cat "$(dirname "$0")/intel-gpu-top.json" | sed '$d'   # everything except the closing ]
sleep 30
